NODE_ENV=development
APP_STAGE=dev
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_wallet
SESSION_SECRET=your-random-32-byte-base64-secret-here
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Demo seeding is disabled by default. Set these only for an explicitly confirmed development database.
DEMO_SEED_ENABLED=false
DEMO_SEED_CONFIRM_DATABASE=
ALLOW_REMOTE_DEMO_SEED=false
# DEMO_SEED_PASSWORD=use-a-private-password-at-runtime
