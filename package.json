{
  "name": "fuel-wallet",
  "version": "1.0.0",
  "description": "Wallet for fuel stations",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:front": "npm --prefix front install && npm --prefix front run build",
    "build": "tsc -p tsconfig.build.json && npm --prefix front install && npm --prefix front run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cross-env NODE_ENV=test APP_STAGE=test DATABASE_URL=postgresql://test:test@localhost:5432/fuel_wallet_test vitest run",
    "test:watch": "cross-env NODE_ENV=test APP_STAGE=test DATABASE_URL=postgresql://test:test@localhost:5432/fuel_wallet_test vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:bootstrap-finance": "tsx src/scripts/bootstrap-finance.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:seed:demo:dry-run": "tsx src/scripts/seed-demo.ts --dry-run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@epic-web/remember": "^1.1.0",
    "@types/connect-pg-simple": "^7.0.3",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "custom-env": "^2.0.6",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "supertest": "^6.3.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
